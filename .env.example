# For Vercel, use the Supabase shared transaction pooler URL (port 6543).
BETTER_AUTH_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-DATABASE-PASSWORD]@[POOLER-HOST]:6543/postgres?sslmode=require
RESEND_API_KEY=replace-with-your-resend-api-key
